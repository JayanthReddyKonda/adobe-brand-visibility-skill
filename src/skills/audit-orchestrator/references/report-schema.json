{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "audit_status",
    "summary",
    "findings"
  ],
  "properties": {
    "site": {
      "type": "string"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "proactive_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "summary",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "technical_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "creative_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "verification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "root_cause",
          "evidence",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "root_cause": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "required": [
              "summary",
              "scope",
              "sources"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "url",
                    "type",
                    "observation"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "observation": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "suggested_action": {
            "type": "object",
            "required": [
              "summary",
              "priority"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "technical_fix": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "creative_fix": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "verification": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "impact": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_classes": {
      "type": "object",
      "properties": {
        "declared_identity_nodes": {
          "type": "object"
        },
        "verified_candidate_backlinks": {
          "type": "object"
        }
      }
    },
    "analytics_summary": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "first_party_analytics_provided": {
          "type": "boolean"
        },
        "pages_with_analytics": {
          "type": "integer"
        },
        "average_observed_bounce_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "average_observed_dwell_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "corroborated_findings_count": {
          "type": "integer"
        },
        "mitigated_findings_count": {
          "type": "integer"
        }
      }
    },
    "page_improvement_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_url",
          "page_type",
          "current_citability_score",
          "gap_analysis",
          "prescribed_actions",
          "epistemic_qualification"
        ],
        "properties": {
          "page_url": {
            "type": "string"
          },
          "page_type": {
            "type": "string"
          },
          "word_count": {
            "type": "integer"
          },
          "current_citability_score": {
            "type": "number"
          },
          "target_citability_score": {
            "type": "number"
          },
          "dimension_scores": {
            "type": "object"
          },
          "gap_analysis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prescribed_actions": {
            "type": "object",
            "properties": {
              "immediate_structural_actions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "textual_modifications": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "passage_chunking_plan": {
                "type": "string"
              }
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "epistemic_qualification": {
            "type": "string"
          },
          "evidence_genres": {
            "type": "object"
          },
          "attributed_quotations": {
            "type": "object"
          },
          "bluf_placement": {
            "type": "object"
          },
          "keyword_stuffing": {
            "type": "object"
          },
          "url": {
            "type": "string"
          },
          "citability_score": {
            "type": "number"
          }
        }
      }
    },
    "geo_citability_summary": {
      "type": "object"
    },
    "engagement_continuity_summary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}