{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "description": "Production Draft-07 schema for Brand AI-Readiness, Generative Engine Optimization (GEO), and AI Visibility Audit Reports.",
  "type": "object",
  "required": [
    "schema_version",
    "site",
    "audited_at",
    "audit_status",
    "summary",
    "findings"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional URI or path to JSON Schema definition"
    },
    "schema_version": {
      "type": "string",
      "description": "Report schema version (e.g. 1.0.0)"
    },
    "site": {
      "type": "string",
      "description": "Target website domain or URL audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of audit execution"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "description": "Counts-by-severity summary metadata",
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "unassessable": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed_problems": {
          "type": "integer",
          "minimum": 0
        },
        "detected_archetype": {
          "type": "string",
          "description": "Detected business archetype for contextualized diagnosis"
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "description": "Detected problems hurting AI discoverability, fact consistency, or visitor engagement",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "category",
          "root_cause",
          "confidence",
          "scope",
          "evidence",
          "impact",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier (e.g. F-001, finding-1)"
          },
          "cause_id": {
            "type": "string",
            "description": "Root cause key matching knowledge-base.md"
          },
          "title": {
            "type": "string",
            "description": "Clear descriptive title of the defect"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "description": "Specialist domain category (e.g. discoverability, entity_content, fact_consistency, corroboration, geo_content, engagement)"
          },
          "root_cause": {
            "type": "string",
            "description": "Mechanism-sound explanation of why this defect occurs"
          },
          "evidence": {
            "type": [
              "string",
              "object"
            ],
            "description": "Observable proof of defect: either human-readable string or structured evidence object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "observation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "suggested_action": {
            "type": "object",
            "description": "Prioritized remediation instructions",
            "required": [
              "summary",
              "priority",
              "technical_fix",
              "creative_fix",
              "verification"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Summary of what to change and how"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "technical_fix": {
                "type": [
                  "string",
                  "object",
                  "null"
                ],
                "description": "Precise code, markup, or patch-applicable object for developers or downstream agents",
                "properties": {
                  "file_or_route": { "type": "string" },
                  "change_type": { "type": "string", "enum": ["insert", "replace", "delete"] },
                  "snippet": { "type": "string" },
                  "anchor": { "type": "string" }
                }
              },
              "creative_fix": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Copywriting, UX, and content guidelines for editors and marketers"
              },
              "is_proactive": {
                "type": "boolean",
                "description": "True if this action goes beyond a detected defect"
              },
              "verification": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Deterministic test or request to verify the fix"
              },
              "priority_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Task ranking index: 5 * severity + (6 - difficulty)"
              },
              "difficulty": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5,
                "description": "Remediation difficulty from 1 (trivial config/copy) to 5 (architectural refactor)"
              }
            }
          },
          "impact": {
            "type": "string",
            "description": "How the defect impacts AI search citation probability or visitor retention"
          },
          "scope": {
            "type": [
              "string",
              "object"
            ],
            "description": "Granular defect scope (entity, page, route, or matrix)",
            "properties": {
              "type": { "type": "string" },
              "entity": { "type": "string" },
              "attribute": { "type": "string" },
              "locale": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "downstream_symptoms": {
            "type": "array",
            "description": "Downstream consequential defects suppressed or subsumed by this keystone cause",
            "items": {
              "type": "string"
            }
          },
          "affected_urls": {
            "type": "array",
            "description": "List of URLs or routes directly affected by this defect",
            "items": {
              "type": "string"
            }
          },
          "priority_index": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Task ranking index: 5 * severity + (6 - difficulty)"
          },
          "difficulty": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5,
            "description": "Remediation difficulty from 1 (trivial config/copy) to 5 (architectural refactor)"
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1,
            "description": "Global 1-N rank across ALL findings in this report, reflecting LLM ordering judgment"
          },
          "priority_justification": {
            "type": "string",
            "description": "One sentence explaining why this finding outranks the adjacent one(s) of equal severity"
          },
          "dag_node": {
            "type": "string",
            "description": "Which Causal DAG node produced this finding (e.g. RETRIEVAL, RENDERING, ENTITY, FACTS, CORROBORATION, GEO_CITABILITY, ENGAGEMENT)"
          }
        }
      }
    },
    "proactive_actions": {
      "type": "array",
      "description": "Proactive improvements that strengthen discoverability or engagement even where no explicit defect was found",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "technical_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "creative_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "page_improvement_plans": {
      "type": "array",
      "description": "Deterministic page-level GEO content optimization plans derived from citability vectors",
      "items": {
        "type": "object",
        "properties": {
          "page_url": {
            "type": "string"
          },
          "page_type": {
            "type": "string"
          },
          "current_citability_score": {
            "type": "number"
          },
          "target_citability_score": {
            "type": "number"
          },
          "gap_analysis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prescribed_actions": {
            "type": "object"
          },
          "priority": {
            "type": "string"
          },
          "epistemic_qualification": {
            "type": "string"
          }
        }
      }
    },
    "geo_citability_summary": {
      "type": "object",
      "description": "Aggregate domain citability metrics"
    },
    "engagement_continuity_summary": {
      "type": "object",
      "description": "Aggregate visitor orientation and intent-handoff continuity metrics"
    },
    "ai_agent_scrapeability_summary": {
      "type": "object",
      "description": "Crawl efficiency, SNR, and content extraction metrics from web-scraper"
    },
    "evidence_classes": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "description": "Assessment coverage across the 134-item research catalogue and execution environment capabilities"
    },
    "observations": {
      "type": "array",
      "description": "Non-actionable or unassessable informational observations outside defect counts",
      "items": {
        "type": "object"
      }
    },
    "dropped_findings": {
      "type": "array",
      "description": "Mechanically rejected findings that lacked verifiable evidence locators or violated schema constraints",
      "items": {
        "type": "object"
      }
    },
    "suppressed_findings": {
      "type": "array",
      "description": "Evidence-backed findings suppressed as downstream symptoms by the 6-layer causal DAG",
      "items": {
        "type": "object"
      }
    },
    "run_manifest": {
      "type": "object",
      "description": "Machine-readable execution provenance recording site, timestamps, references, and validation status"
    },
    "limitations": {
      "type": "array",
      "description": "Explicit epistemic audit boundaries and measurement limitations",
      "items": {
        "type": "string"
      }
    },
    "archetype": {
      "type": [
        "string",
        "object"
      ],
      "description": "Detected business archetype and confidence"
    },
    "readiness": {
      "type": "object",
      "description": "Deterministic readiness score, grade, and dimension breakdown",
      "properties": {
        "composite_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "grade": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        },
        "dimensions": {
          "type": "object"
        },
        "weights": {
          "type": "object"
        },
        "dimension_status": {
          "type": "object",
          "description": "Epistemic certainty status per dimension (e.g. observed, provisional, heuristic_only)"
        },
        "score_scope": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}