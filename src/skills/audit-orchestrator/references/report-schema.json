{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrandAIReadinessAuditReport",
  "description": "Production Draft-07 schema for Brand AI-Readiness, GEO, and Visibility Audit Reports, strictly conforming to Adobe Hackathon Round 3 requirements.",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "summary",
    "findings"
  ],
  "properties": {
    "site": {
      "type": "string",
      "description": "Target website domain or URL audited"
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of audit execution"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "description": "Counts-by-severity summary metadata",
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "description": "Detected problems hurting AI discoverability, fact consistency, or visitor engagement",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "evidence",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding identifier (e.g. F-001, finding-1)"
          },
          "cause_id": {
            "type": "string",
            "description": "Root cause key matching audit-orchestrator-knowledge-base.md"
          },
          "title": {
            "type": "string",
            "description": "Clear descriptive title of the defect"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "description": "Specialist domain category (e.g. discoverability, entity_content, fact_consistency, corroboration, geo_content, engagement)"
          },
          "root_cause": {
            "type": "string",
            "description": "Mechanism-sound explanation of why this defect occurs"
          },
          "evidence": {
            "type": [
              "string",
              "object"
            ],
            "description": "Observable proof of defect: either human-readable string or structured evidence object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "observation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "suggested_action": {
            "type": "object",
            "description": "Prioritized remediation instructions",
            "required": [
              "summary",
              "priority"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Summary of what to change and how"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "technical_fix": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Precise code, markup, or configuration snippet for developers"
              },
              "creative_fix": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Copywriting, UX, and content guidelines for editors and marketers"
              },
              "verification": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Deterministic test or request to verify the fix"
              }
            }
          },
          "impact": {
            "type": "string",
            "description": "How the defect impacts AI search citation probability or visitor retention"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "proactive_actions": {
      "type": "array",
      "description": "Proactive improvements that strengthen discoverability or engagement even where no explicit defect was found",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "technical_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "creative_fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "page_improvement_plans": {
      "type": "array",
      "description": "Deterministic page-level GEO content optimization plans derived from citability vectors",
      "items": {
        "type": "object",
        "properties": {
          "page_url": {
            "type": "string"
          },
          "page_type": {
            "type": "string"
          },
          "current_citability_score": {
            "type": "number"
          },
          "target_citability_score": {
            "type": "number"
          },
          "gap_analysis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prescribed_actions": {
            "type": "object"
          },
          "priority": {
            "type": "string"
          },
          "epistemic_qualification": {
            "type": "string"
          }
        }
      }
    },
    "geo_citability_summary": {
      "type": "object",
      "description": "Aggregate domain citability metrics"
    },
    "engagement_continuity_summary": {
      "type": "object",
      "description": "Aggregate visitor orientation and intent-handoff continuity metrics"
    },
    "ai_agent_scrapeability_summary": {
      "type": "object",
      "description": "Crawl efficiency, SNR, and content extraction metrics from web-scraper"
    },
    "evidence_classes": {
      "type": "object"
    },
    "analytics_summary": {
      "type": "object"
    }
  },
  "additionalProperties": false
}