# Auto-detect text files and normalize line endings
* text=auto

# Text files normalized to LF
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.zip binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
